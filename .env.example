# NewsAPI.org — https://newsapi.org (development/localhost only on the free
# Developer plan; production requires a plan/licence that permits it)
NEWS_API_KEY=

# OpenWeather API
WEATHER_API_KEY=

# Sport API (API-Football / API-Sports)
SPORTS_API_KEY=
SPORTS_API_BASE_URL=
SPORTS_API_HOST=

# Port the Express API/server process listens on
PORT=8787

# Postgres connection string (pooled) — set automatically by Vercel's
# Postgres integration in deployed environments; for local dev run
# `vercel env pull .env` after provisioning, or point at your own Postgres.
POSTGRES_URL=

# Session cookie
SESSION_COOKIE_NAME=dw_session
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Frontend origin (dev CORS + email links)
APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=The Daily Wire <onboarding@resend.dev>

# Web Push (VAPID) — optional, only needed for browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Resend webhook signing secret — required to receive bounce/complaint/delivery
# events at POST /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Shared secret Vercel Cron sends as a Bearer token when invoking
# /api/cron/newsletter — reject any request without a matching header.
CRON_SECRET=