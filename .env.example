# NEWSDATA.IO
NEWSDATA_API_KEY=

# OpenWeather API
WEATHER_API_KEY=

# Sport API (API-Football / API-Sports)
SPORTS_API_KEY=
SPORTS_API_BASE_URL=
SPORTS_API_HOST=

# Port the Express API/server process listens on
PORT=8787

# Local SQLite database file
DB_PATH=server/data/app.db

# Session cookie
SESSION_COOKIE_NAME=dw_session
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Frontend origin (dev CORS + email links)
APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=The Daily Wire <onboarding@resend.dev>

# Web Push (VAPID) — optional, only needed for browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Resend webhook signing secret — required to receive bounce/complaint/delivery
# events at POST /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Set to "true" to run the daily/weekly newsletter digest cron jobs
NEWSLETTER_CRON_ENABLED=false